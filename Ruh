<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>RuH Studio</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
:root{
  --c1:#ff2d55;--c2:#ff9f0a;--c3:#30d158;--c4:#0a84ff;--c5:#bf5af2;--c6:#ff6b35;
  --bg:#07070e;--bg2:#0d0d18;--surface:#131320;--surface2:#191926;
  --border:rgba(255,255,255,0.08);--border2:rgba(255,255,255,0.13);
  --text:#eeeef5;--muted:#888899;--dim:#44445a;
  --fd:'Syne',sans-serif;--fb:'DM Sans',sans-serif;--fm:'JetBrains Mono',monospace;
  --nav-h:56px;--bot-h:64px;--safe:env(safe-area-inset-bottom,0px);
}
html,body{height:100%;overflow:hidden;}
body{background:var(--bg);color:var(--text);font-family:var(--fb);display:flex;flex-direction:column;}

/* ── SCREENS ─────────────────────── */
.screen{display:none;flex-direction:column;height:100%;}
.screen.active{display:flex;}

/* ── TOPNAV ──────────────────────── */
.topnav{height:var(--nav-h);flex-shrink:0;background:rgba(7,7,14,0.97);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 16px;gap:10px;z-index:200;}
.logo{font-family:var(--fd);font-size:1.15rem;font-weight:800;background:linear-gradient(135deg,var(--c1),var(--c2),var(--c5));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:-0.03em;}
.nav-right{margin-left:auto;display:flex;align-items:center;gap:8px;}
.badge-pill{display:flex;align-items:center;gap:5px;padding:4px 10px;border-radius:100px;font-size:0.68rem;font-weight:600;}
.badge-green{background:rgba(48,209,88,0.1);border:1px solid rgba(48,209,88,0.2);color:var(--c3);}
.badge-red{background:rgba(255,45,85,0.1);border:1px solid rgba(255,45,85,0.2);color:var(--c1);}
.blink{width:6px;height:6px;border-radius:50%;animation:blink 2s infinite;}
.blink-g{background:var(--c3);}
.blink-r{background:var(--c1);}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:0.3;}}
.icon-btn{background:none;border:none;color:var(--muted);font-size:1.2rem;cursor:pointer;padding:6px;}

/* ── SCROLL ──────────────────────── */
.scroll{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;}
.pad{padding:16px;padding-bottom:calc(var(--bot-h) + 20px + var(--safe));}

/* ── BOTTOM NAV ──────────────────── */
.botnav{height:calc(var(--bot-h) + var(--safe));padding-bottom:var(--safe);background:rgba(7,7,14,0.97);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-top:1px solid var(--border);display:flex;align-items:flex-start;padding-top:8px;flex-shrink:0;}
.bot-btn{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;background:none;border:none;cursor:pointer;padding:4px;font-size:0.6rem;color:var(--muted);font-family:var(--fb);transition:color 0.15s;}
.bot-btn.active{color:var(--c1);}
.bot-icon{font-size:1.25rem;line-height:1;}
.bot-btn.active .bot-icon{filter:drop-shadow(0 0 6px var(--c1));}

/* ── PAGES ───────────────────────── */
.page{display:none;}
.page.active{display:block;}

/* ── CARDS ───────────────────────── */
.card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:16px;margin-bottom:12px;}
.card-title{font-family:var(--fd);font-size:0.95rem;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:8px;}

/* ── STAT GRID ───────────────────── */
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px;}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:14px;position:relative;overflow:hidden;}
.stat-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;}
.sc1::after{background:linear-gradient(90deg,var(--c1),var(--c2));}
.sc2::after{background:linear-gradient(90deg,var(--c4),var(--c5));}
.sc3::after{background:linear-gradient(90deg,var(--c3),var(--c4));}
.sc4::after{background:linear-gradient(90deg,var(--c5),var(--c1));}
.stat-num{font-family:var(--fd);font-size:1.7rem;font-weight:800;line-height:1;}
.stat-lbl{font-size:0.7rem;color:var(--muted);margin-top:3px;}

/* ── FORMS ───────────────────────── */
.fg{margin-bottom:12px;}
.lbl{font-size:0.7rem;font-weight:600;color:var(--muted);letter-spacing:0.06em;text-transform:uppercase;display:block;margin-bottom:5px;}
.inp,.sel,.ta{width:100%;background:rgba(0,0,0,0.35);border:1px solid var(--border2);border-radius:10px;padding:11px 14px;color:var(--text);font-family:var(--fb);font-size:0.88rem;outline:none;transition:border-color 0.2s;}
.ta{resize:vertical;min-height:80px;}
.inp:focus,.sel:focus,.ta:focus{border-color:var(--c1);}
.sel option{background:var(--bg2);}
.inp-wrap{position:relative;}
.inp-wrap .inp{padding-right:42px;}
.eye{position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--muted);cursor:pointer;font-size:1rem;}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}

/* ── BUTTONS ─────────────────────── */
.btn{padding:10px 18px;border-radius:10px;font-family:var(--fb);font-size:0.82rem;font-weight:600;cursor:pointer;border:none;transition:all 0.15s;display:inline-flex;align-items:center;gap:6px;}
.btn:active{transform:scale(0.96);}
.btn-full{width:100%;justify-content:center;padding:13px;}
.btn-primary{background:linear-gradient(135deg,var(--c1),var(--c5));color:#fff;}
.btn-green{background:linear-gradient(135deg,var(--c3),var(--c4));color:#fff;}
.btn-ghost{background:rgba(255,255,255,0.06);color:var(--muted);border:1px solid var(--border);}
.btn-red{background:rgba(255,45,85,0.1);color:var(--c1);border:1px solid rgba(255,45,85,0.2);}
.btn-orange{background:linear-gradient(135deg,var(--c2),var(--c6));color:#fff;}
.btn-blue{background:linear-gradient(135deg,var(--c4),var(--c5));color:#fff;}

/* ── SERIAL KEY CARD ─────────────── */
.key-item{background:rgba(0,0,0,0.25);border:1px solid var(--border);border-radius:12px;padding:12px 14px;margin-bottom:8px;display:flex;align-items:center;gap:10px;}
.key-item.used{opacity:0.5;}
.key-code{font-family:var(--fm);font-size:0.82rem;color:var(--c4);flex:1;word-break:break-all;}
.key-badge{font-size:0.65rem;font-weight:700;padding:3px 9px;border-radius:100px;white-space:nowrap;flex-shrink:0;}
.kb-active{background:rgba(48,209,88,0.12);color:var(--c3);border:1px solid rgba(48,209,88,0.2);}
.kb-used{background:rgba(255,255,255,0.06);color:var(--muted);}
.kb-expired{background:rgba(255,45,85,0.1);color:var(--c1);}

/* ── CHAT ────────────────────────── */
.chat-wrap{display:flex;flex-direction:column;flex:1;overflow:hidden;}
.chat-topbar{padding:10px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;flex-shrink:0;background:var(--bg2);}
.model-pill{background:rgba(255,45,85,0.1);border:1px solid rgba(255,45,85,0.2);color:var(--c1);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:100px;cursor:pointer;border:none;font-family:var(--fb);}
.chat-msgs{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:14px;display:flex;flex-direction:column;gap:12px;}
.msg{display:flex;gap:8px;animation:fadeUp 0.25s ease;}
.msg.user{flex-direction:row-reverse;}
.msg-av{width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:0.85rem;flex-shrink:0;}
.msg-bbl{max-width:78%;padding:10px 14px;border-radius:14px;font-size:0.85rem;line-height:1.55;word-break:break-word;}
.msg.ai .msg-bbl{background:var(--surface2);border:1px solid var(--border);}
.msg.user .msg-bbl{background:linear-gradient(135deg,var(--c1),var(--c5));color:#fff;}
.chat-bar{padding:10px 12px;border-top:1px solid var(--border);display:flex;gap:8px;align-items:flex-end;flex-shrink:0;background:var(--bg);padding-bottom:calc(10px + var(--safe));}
.chat-inp{flex:1;background:rgba(0,0,0,0.35);border:1px solid var(--border2);border-radius:22px;padding:10px 16px;color:var(--text);font-family:var(--fb);font-size:0.88rem;resize:none;outline:none;max-height:100px;min-height:42px;transition:border-color 0.2s;}
.chat-inp:focus{border-color:var(--c1);}
.send-btn{width:42px;height:42px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,var(--c1),var(--c5));color:#fff;border:none;cursor:pointer;font-size:1.05rem;display:flex;align-items:center;justify-content:center;transition:transform 0.15s;}
.send-btn:active{transform:scale(0.9);}
.send-btn:disabled{opacity:0.4;}
.typing-dots{display:flex;gap:4px;padding:10px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:14px;width:fit-content;}
.dot{width:6px;height:6px;border-radius:50%;background:var(--muted);animation:bounce 1.2s infinite;}
.dot:nth-child(2){animation-delay:.2s;}
.dot:nth-child(3){animation-delay:.4s;}
@keyframes bounce{0%,100%{transform:translateY(0);}50%{transform:translateY(-5px);opacity:0.4;}}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}

/* ── SHEET ───────────────────────── */
.sheet-bg{position:fixed;inset:0;background:rgba(0,0,0,0.65);z-index:400;opacity:0;pointer-events:none;transition:opacity 0.2s;}
.sheet-bg.open{opacity:1;pointer-events:all;}
.sheet{position:fixed;bottom:0;left:0;right:0;background:var(--bg2);border-top:1px solid var(--border2);border-radius:20px 20px 0 0;z-index:401;transform:translateY(100%);transition:transform 0.3s cubic-bezier(.4,0,.2,1);padding:0 16px calc(24px + var(--safe));max-height:80vh;overflow-y:auto;}
.sheet.open{transform:translateY(0);}
.sheet-handle{width:36px;height:4px;border-radius:2px;background:rgba(255,255,255,0.15);margin:12px auto 18px;}
.sheet-title{font-family:var(--fd);font-size:1.05rem;font-weight:800;margin-bottom:14px;}
.model-row{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:12px;margin-bottom:6px;cursor:pointer;background:rgba(0,0,0,0.25);border:1px solid var(--border);transition:all 0.15s;}
.model-row.active,.model-row:active{border-color:rgba(255,45,85,0.3);background:rgba(255,45,85,0.06);}
.mdot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
.minfo{flex:1;}
.mname{font-size:0.88rem;font-weight:600;}
.mtag{font-size:0.72rem;color:var(--muted);margin-top:1px;}

/* ── IMG/CODE OUTPUT ─────────────── */
.img-box{background:var(--surface);border:1px solid var(--border);border-radius:16px;min-height:200px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10px;color:var(--muted);margin-top:12px;overflow:hidden;position:relative;}
.img-box img{width:100%;height:auto;border-radius:14px;display:block;}
.dl-btn{position:absolute;bottom:10px;right:10px;background:rgba(0,0,0,0.7);border:1px solid var(--border2);color:var(--text);border-radius:8px;padding:6px 12px;font-size:0.75rem;cursor:pointer;text-decoration:none;}
pre{background:rgba(0,0,0,0.55);border:1px solid var(--border);border-radius:12px;padding:14px;font-family:var(--fm);font-size:0.75rem;overflow-x:auto;white-space:pre-wrap;word-break:break-word;color:var(--text);min-height:100px;max-height:360px;overflow-y:auto;margin-top:10px;line-height:1.5;}

/* ── PLAN CARDS ──────────────────── */
.plan-card{background:rgba(0,0,0,0.2);border:2px solid var(--border);border-radius:14px;padding:13px 16px;margin-bottom:8px;display:flex;align-items:center;justify-content:space-between;}
.plan-name-l{font-size:0.88rem;font-weight:600;}
.plan-price-l{font-family:var(--fd);font-size:1.1rem;font-weight:800;color:#ff4d94;}

/* ── TOAST ───────────────────────── */
.toast-wrap{position:fixed;bottom:calc(var(--bot-h) + 14px + var(--safe));left:16px;right:16px;z-index:999;display:flex;flex-direction:column;gap:8px;pointer-events:none;}
.toast{background:var(--surface2);border:1px solid var(--border2);border-radius:12px;padding:11px 16px;font-size:0.82rem;display:flex;align-items:center;gap:8px;box-shadow:0 8px 32px rgba(0,0,0,0.5);animation:slideUp 0.3s ease;pointer-events:all;}
@keyframes slideUp{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
.toast.success{border-color:rgba(48,209,88,0.3);}
.toast.error{border-color:rgba(255,45,85,0.3);}
.toast.info{border-color:rgba(10,132,255,0.3);}

/* ── DRAWER ──────────────────────── */
.drawer-bg{position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:300;opacity:0;pointer-events:none;transition:opacity 0.25s;}
.drawer-bg.open{opacity:1;pointer-events:all;}
.drawer{position:fixed;top:0;left:0;bottom:0;width:260px;background:var(--bg2);border-right:1px solid var(--border);z-index:301;transform:translateX(-100%);transition:transform 0.28s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;padding:16px 12px;padding-top:calc(16px + env(safe-area-inset-top));overflow-y:auto;}
.drawer.open{transform:translateX(0);}
.drawer-logo{font-family:var(--fd);font-size:1.3rem;font-weight:800;background:linear-gradient(135deg,var(--c1),var(--c2),var(--c5));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:6px;padding:0 8px;}
.drawer-sub{font-size:0.7rem;color:var(--muted);padding:0 8px;margin-bottom:20px;}
.nav-lbl{font-size:0.62rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--dim);padding:10px 8px 5px;margin-top:6px;}
.nav-btn{display:flex;align-items:center;gap:10px;padding:11px 10px;border-radius:11px;font-size:0.88rem;color:var(--muted);cursor:pointer;border:none;background:none;width:100%;text-align:left;transition:all 0.15s;font-family:var(--fb);}
.nav-btn:active,.nav-btn:hover{background:rgba(255,255,255,0.05);color:var(--text);}
.nav-btn.active{background:rgba(255,45,85,0.1);color:var(--c1);}
.nav-icon{font-size:1rem;width:22px;text-align:center;}

/* ── LOCK SCREEN ─────────────────── */
.lock-screen{position:fixed;inset:0;background:var(--bg);z-index:500;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;}
.lock-screen.hidden{display:none;}
.lock-logo{font-family:var(--fd);font-size:2.5rem;font-weight:800;background:linear-gradient(135deg,var(--c1),var(--c2),var(--c5));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:8px;text-align:center;}
.lock-sub{color:var(--muted);font-size:0.85rem;text-align:center;margin-bottom:36px;}
.lock-box{background:var(--surface);border:1px solid var(--border2);border-radius:20px;padding:24px;width:100%;max-width:360px;}
.lock-title{font-family:var(--fd);font-size:1.1rem;font-weight:800;margin-bottom:6px;text-align:center;}
.lock-desc{font-size:0.8rem;color:var(--muted);text-align:center;margin-bottom:20px;}
.serial-inp{width:100%;background:rgba(0,0,0,0.4);border:2px solid var(--border2);border-radius:12px;padding:14px 16px;color:var(--text);font-family:var(--fm);font-size:1rem;outline:none;text-align:center;letter-spacing:0.08em;text-transform:uppercase;transition:border-color 0.2s;margin-bottom:14px;}
.serial-inp:focus{border-color:var(--c1);}
.serial-inp::placeholder{color:var(--dim);font-size:0.85rem;letter-spacing:0;}
.lock-hint{font-size:0.72rem;color:var(--dim);text-align:center;margin-top:12px;}
.lock-hint a{color:var(--c1);text-decoration:none;}

/* ── ADMIN SCREEN ────────────────── */
.admin-login{position:fixed;inset:0;background:var(--bg);z-index:600;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;}
.admin-login.hidden{display:none;}
.admin-badge{background:rgba(255,159,10,0.1);border:1px solid rgba(255,159,10,0.25);color:var(--c2);font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;padding:5px 14px;border-radius:100px;margin-bottom:20px;}

/* ── SPINNER ─────────────────────── */
.spin{display:inline-block;width:16px;height:16px;border:2px solid rgba(255,255,255,0.2);border-top-color:#fff;border-radius:50%;animation:spin 0.7s linear infinite;vertical-align:middle;}
@keyframes spin{to{transform:rotate(360deg);}}

/* ── ACTIVITY ────────────────────── */
.act-item{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border);}
.act-item:last-child{border:none;}
.act-icon{width:32px;height:32px;border-radius:9px;background:rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.act-text{font-size:0.82rem;}
.act-time{font-size:0.7rem;color:var(--muted);margin-top:1px;}
.empty{text-align:center;padding:30px;color:var(--muted);font-size:0.84rem;}

/* ── USAGE BAR ───────────────────── */
.ubar{margin-bottom:11px;}
.ubar-row{display:flex;justify-content:space-between;margin-bottom:4px;font-size:0.78rem;}
.bar-bg{height:5px;background:rgba(255,255,255,0.06);border-radius:3px;overflow:hidden;}
.bar-fill{height:100%;border-radius:3px;}

/* ── NOTICE ──────────────────────── */
.notice{border-radius:10px;padding:10px 14px;font-size:0.78rem;margin-bottom:12px;}
.notice-orange{background:rgba(255,159,10,0.08);border:1px solid rgba(255,159,10,0.2);color:var(--c2);}
.notice-green{background:rgba(48,209,88,0.08);border:1px solid rgba(48,209,88,0.2);color:var(--c3);}
.notice-blue{background:rgba(10,132,255,0.08);border:1px solid rgba(10,132,255,0.2);color:var(--c4);}
</style>
</head>
<body>

<!-- ══════════════════════════════════════
     ADMIN LOGIN OVERLAY
══════════════════════════════════════ -->
<div class="admin-login hidden" id="admin-login">
  <div class="admin-badge">⚙️ Admin Panel</div>
  <div style="font-family:var(--fd);font-size:1.8rem;font-weight:800;margin-bottom:8px;text-align:center;">RuH Studio</div>
  <div style="color:var(--muted);font-size:0.84rem;text-align:center;margin-bottom:28px;">Admin Access Only</div>
  <div style="background:var(--surface);border:1px solid var(--border2);border-radius:20px;padding:24px;width:100%;max-width:360px;">
    <div class="fg">
      <label class="lbl">Admin Password</label>
      <div class="inp-wrap">
        <input class="inp" type="password" id="admin-pass-inp" placeholder="Enter admin password" onkeydown="if(event.key==='Enter')adminLogin()">
        <button class="eye" onclick="toggleVis('admin-pass-inp')">👁</button>
      </div>
    </div>
    <button class="btn btn-orange btn-full" onclick="adminLogin()">🔓 Enter Admin Panel</button>
    <button class="btn btn-ghost btn-full" style="margin-top:8px;" onclick="closeAdmin()">← Back to App</button>
    <div style="font-size:0.72rem;color:var(--dim);text-align:center;margin-top:14px;">Default password: <code style="font-family:var(--fm);color:var(--c2);">ruh2024</code></div>
  </div>
</div>

<!-- ══════════════════════════════════════
     LOCK SCREEN (Customer sees this first)
══════════════════════════════════════ -->
<div class="lock-screen" id="lock-screen">
  <div style="margin-bottom:32px;text-align:center;">
    <div class="lock-logo">RuH Studio</div>
    <div class="lock-sub">AI-Powered All-in-One Platform</div>
    <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:-10px;">
      <span style="font-size:0.72rem;color:var(--dim);">🤖 AI Chat</span>
      <span style="font-size:0.72rem;color:var(--dim);">🎨 Image Gen</span>
      <span style="font-size:0.72rem;color:var(--dim);">⚡ Code Gen</span>
      <span style="font-size:0.72rem;color:var(--dim);">📊 Analytics</span>
    </div>
  </div>
  <div class="lock-box">
    <div style="text-align:center;font-size:2rem;margin-bottom:10px;">🔐</div>
    <div class="lock-title">Enter Serial Key</div>
