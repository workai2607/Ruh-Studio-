// ══════════════════════════════════════════
//  AI CHAT
// ══════════════════════════════════════════
function pickModel(provider, model, name, el) {
  document.querySelectorAll('#model-sheet .model-row').forEach(r => {
    r.classList.remove('active');
    const chk = r.querySelector('.mcheck');
    if (chk) chk.remove();
  });
  el.classList.add('active');
  const chk = document.createElement('span');
  chk.className = 'mcheck'; chk.style.color = 'var(--c3)'; chk.textContent = '✓';
  el.appendChild(chk);
  S.provider = provider; S.model = model; S.modelName = name;
  document.getElementById('active-model-name').textContent = name;
  closeSheet('model-sheet');
  toast('Model: ' + name, 'success');
}

async function sendMsg() {
  const inp = document.getElementById('chat-inp');
  const text = inp.value.trim();
  if (!text) return;

  const needKey = S.provider === 'claude' ? 'anthropic' : S.provider;
  const apiKey = getAdminKey(needKey);
  if (!apiKey) {
    toast('Admin API key সেট নেই। Admin কে জানান।', 'error'); return;
  }

  inp.value = ''; inp.style.height = 'auto';
  addBubble(text, 'user');
  S.chatHistory.push({ role: 'user', content: text });

  const btn = document.getElementById('send-btn');
  btn.disabled = true; showTyping();

  try {
    let reply = '';
    if (S.provider === 'claude') reply = await callClaude(apiKey);
    else if (S.provider === 'openai') reply = await callOpenAI(apiKey);
    else if (S.provider === 'gemini') reply = await callGemini(apiKey);
    hideTyping();
    addBubble(reply, 'ai');
    S.chatHistory.push({ role: 'assistant', content: reply });
    S.msgCount++;
    document.getElementById('d-msgs').textContent = S.msgCount;
    document.getElementById('d-model').textContent = S.modelName.split(' ')[0];
    addActivity('💬 Chat · ' + S.modelName);
  } catch(e) {
    hideTyping();
    addBubble('❌ Error: ' + e.message, 'ai');
    toast(e.message, 'error');
  }
  btn.disabled = false;
}

async function callClaude(key) {
  const msgs = S.chatHistory.slice(-12);
  const r = await fetch('https://api.anthropic.com/v1/messages', {
    method:'POST',
    headers:{'Content-Type':'application/json','x-api-key':key,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},
    body: JSON.stringify({model:S.model,max_tokens:1024,messages:msgs})
  });
  const d = await r.json();
  if (!r.ok) throw new Error(d.error?.message || 'Anthropic error');
  return d.content[0].text;
}

async function callOpenAI(key) {
  const msgs = S.chatHistory.slice(-12).map(m=>({role:m.role==='ai'?'assistant':m.role,content:m.content}));
  const r = await fetch('https://api.openai.com/v1/chat/completions', {
    method:'POST',
    headers:{'Content-Type':'application/json','Authorization':'Bearer '+key},
    body: JSON.stringify({model:S.model,messages:msgs,max_tokens:1024})
  });
  const d = await r.json();
  if (!r.ok) throw new Error(d.error?.message||'OpenAI error');
  return d.choices[0].message.content;
}

async function callGemini(key) {
  const contents = S.chatHistory.slice(-12).map(m=>({role:m.role==='ai'?'model':'user',parts:[{text:m.content}]}));
  const r = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${S.model}:generateContent?key=${key}`,{
    method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({contents})
  });
  const d = await r.json();
  if (!r.ok) throw new Error(d.error?.message||'Gemini error');
  return d.candidates[0].content.parts[0].text;
}

function addBubble(text, role) {
  const msgs = document.getElementById('chat-msgs');
  const d = document.createElement('div');
  d.className = 'msg ' + role;
  d.innerHTML = `<div class="msg-av" style="background:${role==='ai'?'rgba(255,45,85,0.1)':'rgba(10,132,255,0.1)'};">${role==='ai'?'🤖':'👤'}</div><div class="msg-bbl">${esc(text)}</div>`;
  msgs.appendChild(d); msgs.scrollTop = msgs.scrollHeight;
}
function showTyping() {
  const msgs = document.getElementById('chat-msgs');
  const d = document.createElement('div');
  d.className='msg ai';d.id='typing';
  d.innerHTML=`<div class="msg-av" style="background:rgba(255,45,85,0.1);">🤖</div><div class="typing-dots"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>`;
  msgs.appendChild(d);msgs.scrollTop=msgs.scrollHeight;
}
function hideTyping(){document.getElementById('typing')?.remove();}
function clearChat(){
  S.chatHistory=[];
  document.getElementById('chat-msgs').innerHTML='<div class="msg ai"><div class="msg-av" style="background:rgba(255,45,85,0.1);">🤖</div><div class="msg-bbl">Chat cleared! কীভাবে সাহায্য করতে পারি?</div></div>';
}
function chatKey(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendMsg();}}

// ══════════════════════════════════════════
//  IMAGE GEN
// ══════════════════════════════════════════
async function generateImage() {
  const prompt = document.getElementById('img-prompt').value.trim();
  if (!prompt) { toast('Prompt দিন!', 'error'); return; }
  const engine = document.getElementById('img-engine').value;
  const needKey = engine === 'dalle' ? 'openai' : 'stability';
  const apiKey = getAdminKey(needKey);
  if (!apiKey) { toast('Admin API key সেট নেই।', 'error'); return; }

  const btn = document.getElementById('img-btn');
  const box = document.getElementById('img-box');
  btn.disabled = true; btn.innerHTML = '<span class="spin"></span> Generating...';
  box.innerHTML = '<div style="text-align:center;color:var(--muted);"><div style="font-size:1.8rem;margin-bottom:8px;">⏳</div><div style="font-size:0.8rem;">Generating...</div></div>';

  try {
    let url = '';
    if (engine === 'dalle') {
      const r = await fetch('https://api.openai.com/v1/images/generations',{
        method:'POST',
        headers:{'Content-Type':'application/json','Authorization':'Bearer '+apiKey},
        body:JSON.stringify({model:'dall-e-3',prompt,n:1,size:document.getElementById('img-size').value,style:document.getElementById('img-style').value})
      });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error?.message||'OpenAI error');
      url = d.data[0].url;
    } else {
      const r = await fetch('https://api.stability.ai/v1/generation/stable-diffusion-xl-1024-v1-0/text-to-image',{
        method:'POST',
        headers:{'Content-Type':'application/json','Authorization':'Bearer '+apiKey,'Accept':'application/json'},
        body:JSON.stringify({text_prompts:[{text:prompt,weight:1}],cfg_scale:7,height:1024,width:1024,steps:30,samples:1})
      });
      const d = await r.json();
      if (!r.ok) throw new Error(d.message||'Stability error');
      url = 'data:image/png;base64,'+d.artifacts[0].base64;
    }
    box.innerHTML = `<img src="${url}" alt="Generated"><a class="dl-btn" href="${url}" download="ruh-image.png">⬇ Save</a>`;
    S.imgCount++;
    document.getElementById('d-imgs').textContent = S.imgCount;
    addActivity('🎨 Image generated');
    toast('Image ready!', 'success');
  } catch(e) {
    box.innerHTML = `<div style="color:var(--c1);text-align:center;padding:20px;"><div style="font-size:1.5rem;">❌</div><div style="font-size:0.8rem;margin-top:8px;">${e.message}</div></div>`;
    toast(e.message, 'error');
  }
  btn.disabled = false; btn.innerHTML = '✨ Generate Image';
}

// ══════════════════════════════════════════
//  CODE GEN
// ══════════════════════════════════════════
async function generateCode() {
  const prompt = document.getElementById('code-prompt').value.trim();
  const lang = document.getElementById('code-lang').value;
  const modelPref = document.getElementById('code-model').value;
  if (!prompt) { toast('কী বানাতে চান describe করুন!', 'error'); return; }
  const keyMap = {claude:'anthropic',openai:'openai',gemini:'gemini'};
  const apiKey = getAdminKey(keyMap[modelPref]);
  if (!apiKey) { toast('Admin API key সেট নেই।', 'error'); return; }

  const btn = document.getElementById('code-btn');
  const out = document.getElementById('code-out');
  btn.disabled = true; btn.innerHTML = '<span class="spin"></span> Generating...';
  out.textContent = 'Generating...';

  const sys = `You are an expert ${lang} developer. Write clean, production-ready ${lang} code only. No explanations.`;
  const usr = `Build this in ${lang}:\n${prompt}`;

  try {
    let code = '';
    if (modelPref === 'claude') {
      const r = await fetch('https://api.anthropic.com/v1/messages',{
        method:'POST',
        headers:{'Content-Type':'application/json','x-api-key':apiKey,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},
        body:JSON.stringify({model:'claude-3-5-sonnet-20241022',max_tokens:2048,system:sys,messages:[{role:'user',content:usr}]})
      });
      const d=await r.json(); if(!r.ok)throw new Error(d.error?.message||'Error');
      code=d.content[0].text;
    } else if (modelPref === 'openai') {
      const r = await fetch('https://api.openai.com/v1/chat/completions',{
        method:'POST',
        headers:{'Content-Type':'application/json','Authorization':'Bearer '+apiKey},
        body:JSON.stringify({model:'gpt-4o',max_tokens:2048,messages:[{role:'system',content:sys},{role:'user',content:usr}]})
      });
      const d=await r.json(); if(!r.ok)throw new Error(d.error?.message||'Error');
      code=d.choices[0].message.content;
    } else {
      const r = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent?key=${apiKey}`,{
        method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({contents:[{role:'user',parts:[{text:sys+'\n\n'+usr}]}]})
      });
      const d=await r.json(); if(!r.ok)throw new Error(d.error?.message||'Error');
      code=d.candidates[0].content.parts[0].text;
    }
    code=code.replace(/^```[\w]*\n?/,'').replace(/\n?```$/,'');
    S.codeStr=code; out.textContent=code;
    S.codeCount++;
    document.getElementById('d-codes').textContent=S.codeCount;
    addActivity(`⚡ Code generated (${lang})`);
    toast('Code ready!','success');
  } catch(e){
    out.textContent='// Error: '+e.message;
    toast(e.message,'error');
  }
  btn.disabled=false; btn.innerHTML='⚡ Generate Code';
}

function copyCode(){
  if(!S.codeStr){toast('No code yet','error');return;}
  navigator.clipboard.writeText(S.codeStr).then(()=>toast('Copied!','success'));
}
function dlCode(){
  if(!S.codeStr){toast('No code yet','error');return;}
  const ext={javascript:'js',python:'py',react:'jsx',html:'html',sql:'sql',typescript:'ts'};
  const lang=document.getElementById('code-lang').value;
  const blob=new Blob([S.codeStr],{type:'text/plain'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);a.download='ruh-code.'+(ext[lang]||'txt');a.click();
}

// ══════════════════════════════════════════
//  ACTIVITY & ANALYTICS
// ══════════════════════════════════════════
function addActivity(text) {
  const time = new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
  S.activities.unshift({text,time});
  if(S.activities.length>8)S.activities.pop();
  renderActivity();
  renderAnalytics();
}
function renderActivity() {
  const el = document.getElementById('activity-list');
  if(!S.activities.length){el.innerHTML='<div class="empty">No activity yet</div>';return;}
  el.innerHTML=S.activities.map(a=>`<div class="act-item"><div class="act-icon">${a.text.slice(0,2)}</div><div><div class="act-text">${a.text.slice(3)}</div><div class="act-time">${a.time}</div></div></div>`).join('');
}
function renderAnalytics() {
  const el = document.getElementById('analytics-body');
  el.innerHTML=`
    <div class="stat-grid" style="margin-bottom:12px;">
      <div class="stat-card sc1"><div class="stat-num">${S.msgCount}</div><div class="stat-lbl">Messages</div></div>
      <div class="stat-card sc2"><div class="stat-num">${S.imgCount}</div><div class="stat-lbl">Images</div></div>
      <div class="stat-card sc3"><div class="stat-num">${S.codeCount}</div><div class="stat-lbl">Codes</div></div>
      <div class="stat-card sc4"><div class="stat-num">${S.activities.length}</div><div class="stat-lbl">Actions</div></div>
    </div>
    <div class="card">
      <div class="card-title">📊 Usage Bars</div>
      <div class="ubar"><div class="ubar-row"><span>AI Messages</span><span style="font-weight:600;">${S.msgCount}</span></div><div class="bar-bg"><div class="bar-fill" style="width:${Math.min(S.msgCount*8,100)}%;background:var(--c1);"></div></div></div>
      <div class="ubar"><div class="ubar-row"><span>Images Generated</span><span style="font-weight:600;">${S.imgCount}</span></div><div class="bar-bg"><div class="bar-fill" style="width:${Math.min(S.imgCount*15,100)}%;background:var(--c5);"></div></div></div>
      <div class="ubar"><div class="ubar-row"><span>Codes Generated</span><span style="font-weight:600;">${S.codeCount}</span></div><div class="bar-bg"><div class="bar-fill" style="width:${Math.min(S.codeCount*12,100)}%;background:var(--c2);"></div></div></div>
    </div>`;
}

// ══════════════════════════════════════════
//  UTILS
// ══════════════════════════════════════════
function openSheet(id){document.getElementById(id+'-bg').classList.add('open');document.getElementById(id).classList.add('open');}
function closeSheet(id){document.getElementById(id+'-bg').classList.remove('open');document.getElementById(id).classList.remove('open');}
function toggleVis(id){const el=document.getElementById(id);el.type=el.type==='password'?'text':'password';}
function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>');}
function copyNum(n){navigator.clipboard.writeText(n).then(()=>toast('✅ Number copied!','success'));}
function toast(msg,type='success'){
  const icons={success:'✅',error:'❌',info:'ℹ️'};
  const wrap=document.getElementById('toasts');
  const el=document.createElement('div');
  el.className='toast '+type;
  el.innerHTML=`${icons[type]||'•'} <span>${msg}</span>`;
  wrap.appendChild(el);
  setTimeout(()=>{el.style.opacity='0';el.style.transform='translateY(8px)';el.style.transition='all 0.25s';setTimeout(()=>el.remove(),260);},3200);
}

document.getElementById('chat-inp')?.addEventListener('input',function(){
  this.style.height='auto';this.style.height=Math.min(this.scrollHeight,100)+'px';
});

// ══════════════════════════════════════════
//  START
// ══════════════════════════════════════════
init();
</script>
