<script>
// ══════════════════════════════════════════
//  CONFIG — আপনার Admin Password এখানে
// ══════════════════════════════════════════
const ADMIN_PASSWORD = 'ruh2024'; // ← এটা change করুন!

// ══════════════════════════════════════════
//  STATE
// ══════════════════════════════════════════
const S = {
  provider: 'claude',
  model: 'claude-3-5-sonnet-20241022',
  modelName: 'Claude Sonnet',
  chatHistory: [],
  msgCount: 0, imgCount: 0, codeCount: 0,
  codeStr: '', activities: [],
  activeKey: null
};

// Admin stores keys with prefix so customer can't easily find them
const ADMIN_KEY_PREFIX = '__ruh_adm_';

function getAdminKey(api) { return localStorage.getItem(ADMIN_KEY_PREFIX + api) || ''; }
function setAdminKey(api, val) { localStorage.setItem(ADMIN_KEY_PREFIX + api, val); }

// Serial keys storage
function getSerialKeys() { return JSON.parse(localStorage.getItem('__ruh_serials') || '[]'); }
function setSerialKeys(keys) { localStorage.setItem('__ruh_serials', JSON.stringify(keys)); }

// ══════════════════════════════════════════
//  INIT
// ══════════════════════════════════════════
function init() {
  const savedKey = localStorage.getItem('__ruh_active_session');
  if (savedKey) {
    const serials = getSerialKeys();
    const found = serials.find(k => k.code === savedKey && k.status === 'active');
    if (found && !isExpired(found)) {
      S.activeKey = savedKey;
      showApp(savedKey);
      return;
    } else {
      localStorage.removeItem('__ruh_active_session');
    }
  }
  showLock();
  loadAdminKeysToInputs();
}

function isExpired(keyObj) {
  if (keyObj.duration === 9999) return false;
  const expDate = new Date(keyObj.createdAt);
  expDate.setDate(expDate.getDate() + keyObj.duration);
  return new Date() > expDate;
}

// ══════════════════════════════════════════
//  SCREEN MANAGEMENT
// ══════════════════════════════════════════
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  const sc = document.getElementById(id);
  if (sc) sc.classList.add('active');
}
function showLock() { document.getElementById('lock-screen').classList.remove('hidden'); showScreen(''); }
function showApp(key) {
  document.getElementById('lock-screen').classList.add('hidden');
  document.getElementById('admin-login').classList.add('hidden');
  showScreen('app-screen');
  const short = key.slice(0,8) + '...';
  document.getElementById('user-key-display').textContent = short;
}
function lockApp() {
  localStorage.removeItem('__ruh_active_session');
  S.activeKey = null;
  document.getElementById('lock-screen').classList.remove('hidden');
  showScreen('');
  toast('Logged out', 'info');
}

// ══════════════════════════════════════════
//  LOCK SCREEN
// ══════════════════════════════════════════
function formatSerial(inp) {
  let v = inp.value.replace(/[^a-zA-Z0-9]/g,'').toUpperCase();
  let parts = v.match(/.{1,4}/g) || [];
  inp.value = parts.slice(0,4).join('-');
}

function activateKey() {
  const code = document.getElementById('serial-inp').value.trim().toUpperCase();
  if (code.length < 4) { toast('Serial key দিন!', 'error'); return; }
  const serials = getSerialKeys();
  const found = serials.find(k => k.code === code);
  if (!found) { toast('❌ Key পাওয়া গেলো না!', 'error'); return; }
  if (found.status === 'used') { toast('❌ এই key আগেই ব্যবহার হয়েছে!', 'error'); return; }
  if (isExpired(found)) { toast('❌ Key মেয়াদ শেষ!', 'error'); return; }

  // Mark used & save session
  found.status = 'active';
  found.usedAt = new Date().toISOString();
  setSerialKeys(serials);
  localStorage.setItem('__ruh_active_session', code);
  S.activeKey = code;

  toast('✅ Access activated! Welcome!', 'success');
  setTimeout(() => showApp(code), 800);
}

function showPaymentInfo() {
  document.getElementById('pay-sheet-bg').classList.add('open');
  document.getElementById('pay-sheet').classList.add('open');
}
function closePaySheet() {
  document.getElementById('pay-sheet-bg').classList.remove('open');
  document.getElementById('pay-sheet').classList.remove('open');
}

// ══════════════════════════════════════════
//  ADMIN
// ══════════════════════════════════════════
function showAdminLogin() {
  document.getElementById('admin-login').classList.remove('hidden');
}
function closeAdmin() {
  document.getElementById('admin-login').classList.add('hidden');
}
function adminLogin() {
  const pass = document.getElementById('admin-pass-inp').value;
  if (pass === ADMIN_PASSWORD) {
    document.getElementById('admin-login').classList.add('hidden');
    document.getElementById('lock-screen').classList.add('hidden');
    showScreen('admin-screen');
    loadAdminKeysToInputs();
    refreshAdminStats();
    renderSerialKeyList();
    toast('✅ Admin panel খুলেছে', 'success');
  } else {
    toast('❌ Wrong password!', 'error');
  }
}
function adminLogout() {
  showScreen('');
  document.getElementById('lock-screen').classList.remove('hidden');
  document.getElementById('admin-pass-inp').value = '';
  toast('Admin logged out', 'info');
}

function loadAdminKeysToInputs() {
  ['anthropic','openai','gemini','stability'].forEach(api => {
    const el = document.getElementById('admin-' + api);
    if (el) el.value = getAdminKey(api);
  });
}

function saveAdminKey(api) {
  const val = document.getElementById('admin-' + api).value.trim();
  if (!val) { toast('Key খালি!', 'error'); return; }
  setAdminKey(api, val);
  const st = document.getElementById('admin-' + api + '-st');
  if (st) { st.textContent = '✅ Saved'; st.style.color = 'var(--c3)'; }
  refreshAdminStats();
  toast(`${api} key saved!`, 'success');
}

function testAllKeys() {
  toast('Testing keys...', 'info');
  let count = 0;
  ['anthropic','openai','gemini','stability'].forEach(api => {
    if (getAdminKey(api)) count++;
  });
  toast(`${count}/4 API keys set`, count > 0 ? 'success' : 'error');
}

function adminTab(tab, btn) {
  ['keys','serial','stats'].forEach(t => {
    document.getElementById('atab-' + t + '-content').style.display = t === tab ? 'block' : 'none';
    document.getElementById('atab-' + t).className = 'btn ' + (t === tab ? 'btn-primary' : 'btn-ghost');
  });
  if (tab === 'stats') refreshAdminStats();
  if (tab === 'serial') renderSerialKeyList();
}

function refreshAdminStats() {
  const serials = getSerialKeys();
  document.getElementById('admin-total-keys').textContent = serials.length;
  document.getElementById('admin-active-keys').textContent = serials.filter(k => k.status === 'active' && !isExpired(k)).length;
  document.getElementById('admin-used-keys').textContent = serials.filter(k => k.status === 'used').length;
  let apiCount = 0;
  const apiStatusEl = document.getElementById('admin-api-status');
  let html = '';
  ['anthropic','openai','gemini','stability'].forEach(api => {
    const has = !!getAdminKey(api);
    if (has) apiCount++;
    html += `<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border);font-size:0.82rem;">
      <span>${{anthropic:'🔴 Anthropic',openai:'🟢 OpenAI',gemini:'🔵 Gemini',stability:'🎨 Stability'}[api]}</span>
      <span style="color:${has ? 'var(--c3)' : 'var(--muted)'};">${has ? '✅ Set' : '— Not set'}</span>
    </div>`;
  });
  if (apiStatusEl) apiStatusEl.innerHTML = html;
  document.getElementById('admin-apis-set').textContent = apiCount;
}

// ══════════════════════════════════════════
//  SERIAL KEY GENERATOR
// ══════════════════════════════════════════
function generateSerialKeys() {
  const count = parseInt(document.getElementById('gen-count').value);
  const duration = parseInt(document.getElementById('gen-duration').value);
  const serials = getSerialKeys();
  const newKeys = [];

  for (let i = 0; i < count; i++) {
    const code = genCode();
    const keyObj = {
      code, status: 'active',
      duration, createdAt: new Date().toISOString(),
      usedAt: null
    };
    serials.push(keyObj);
    newKeys.push(code);
  }
  setSerialKeys(serials);
  renderSerialKeyList();
  refreshAdminStats();
  toast(`✅ ${count} key${count > 1 ? 's' : ''} generated!`, 'success');
}

function genCode() {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  let code = '';
  for (let g = 0; g < 4; g++) {
    for (let c = 0; c < 4; c++) code += chars[Math.floor(Math.random() * chars.length)];
    if (g < 3) code += '-';
  }
  return code;
}

function renderSerialKeyList() {
  const serials = getSerialKeys();
  const el = document.getElementById('serial-key-list');
  if (!serials.length) { el.innerHTML = '<div class="empty">No keys yet. Generate করুন!</div>'; return; }
  el.innerHTML = [...serials].reverse().map((k, i) => {
    const expired = isExpired(k);
    const statusClass = expired ? 'kb-expired' : k.status === 'active' ? 'kb-active' : 'kb-used';
    const statusText = expired ? 'Expired' : k.status === 'active' ? 'Active' : 'Used';
    return `<div class="key-item ${k.status === 'used' ? 'used' : ''}">
      <div class="key-code">${k.code}</div>
      <span class="key-badge ${statusClass}">${statusText}</span>
      <button onclick="copySerial('${k.code}')" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:0.9rem;padding:4px;">📋</button>
      <button onclick="deleteSerial('${k.code}')" style="background:none;border:none;color:var(--c1);cursor:pointer;font-size:0.9rem;padding:4px;">🗑</button>
    </div>`;
  }).join('');
}

function copySerial(code) {
  navigator.clipboard.writeText(code).then(() => toast('Copied: ' + code, 'success'));
}

function deleteSerial(code) {
  const serials = getSerialKeys().filter(k => k.code !== code);
  setSerialKeys(serials);
  renderSerialKeyList();
  refreshAdminStats();
  toast('Key deleted', 'info');
}

function copyAllKeys() {
  const serials = getSerialKeys().filter(k => k.status === 'active' && !isExpired(k));
  if (!serials.length) { toast('No active keys!', 'error'); return; }
  const text = serials.map(k => k.code).join('\n');
  navigator.clipboard.writeText(text).then(() => toast(`${serials.length} active keys copied!`, 'success'));
}

// ══════════════════════════════════════════
//  APP NAVIGATION
// ══════════════════════════════════════════
